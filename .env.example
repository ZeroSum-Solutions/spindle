# Evidence clients (packages/evidence). Copy to .env.local and fill in. Never commit real values.

# Contact email sent in User-Agent / mailto to Crossref, OpenAlex, Unpaywall, Wikidata and NCBI.
# Required by the clients that need it; they throw a clear error when it is missing.
SPINDLE_CONTACT_EMAIL=

# Optional. Raises the PubMed rate limit from 3 to 10 requests per second.
NCBI_API_KEY=

# Optional. Semantic Scholar API key (sent as x-api-key). Without it the shared pool applies.
S2_API_KEY=
